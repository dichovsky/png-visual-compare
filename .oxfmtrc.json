{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 140,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "sortPackageJson": false,
    "ignorePatterns": ["node_modules/", "test-results/", ".claude/", "CODEMAP.md"]
}
