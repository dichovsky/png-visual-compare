{
    "name": "png-visual-compare",
    "version": "8.0.0",
    "description": "Node.js utility to compare PNG files or their areas",
    "keywords": [
        "visual testing",
        "compare png",
        "compare images",
        "png",
        "png compare",
        "png diff",
        "image diff",
        "diff"
    ],
    "homepage": "https://github.com/dichovsky/png-visual-compare#readme",
    "bugs": {
        "url": "https://github.com/dichovsky/png-visual-compare/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dichovsky/png-visual-compare.git"
    },
    "funding": {
        "type": "buymeacoffee",
        "url": "https://buymeacoffee.com/dichovsky"
    },
    "license": "MIT",
    "author": "Igor Magdich <magdich.igor@gmail.com>",
    "sideEffects": [
        "./out/vitest.mjs",
        "./out/jest.js"
    ],
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        },
        "./vitest": {
            "types": "./out/vitest.d.mts",
            "import": "./out/vitest.mjs",
            "default": "./out/vitest.mjs"
        },
        "./jest": {
            "types": "./out/jest.d.ts",
            "default": "./out/jest.js"
        },
        "./playwright": {
            "types": "./out/playwright.d.ts",
            "default": "./out/playwright.js"
        }
    },
    "main": "./out/index.js",
    "types": "./out/index.d.ts",
    "files": [
        "./out"
    ],
    "scripts": {
        "prebuild": "npm run clean",
        "build": "tsc --pretty --project tsconfig.prod.json",
        "clean": "rm -rf ./out ./coverage ./test-results",
        "codemap": "node ./scripts/generate-codemap.mts",
        "codemap:check": "node ./scripts/generate-codemap.mts --check",
        "docker:build": "docker build --compress -t test-png-visual-compare .",
        "docker:run": "docker run --rm test-png-visual-compare",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "prepublishOnly": "npm test && npm run build",
        "release:check:pre": "node ./scripts/prerelease-check.mts",
        "release:check:post": "node ./scripts/postrelease-check.mts",
        "test": "npm run test:unit && npm run test:e2e",
        "test:consumer-types": "npm run build && node ./scripts/check-consumer-types.mts",
        "test:docker": "npm run clean && npm run docker:build && npm run docker:run",
        "pretest:e2e": "npx playwright install chromium",
        "test:e2e": "playwright test",
        "test:fast": "vitest run --reporter=verbose",
        "test:license": "node ./scripts/check-licenses.mts",
        "pretest:unit": "npm run clean && npm run codemap:check && npm run lint && npm run format:check && npm run test:license && npm run typecheck",
        "test:unit": "VITEST_FULL_COVERAGE=true vitest run --coverage",
        "tool:excluded-areas-builder": "node -e \"const { execFileSync } = require('node:child_process'); if (process.platform === 'darwin') { execFileSync('open', ['tools/excluded-areas-builder.html'], { stdio: 'inherit' }); } else if (process.platform === 'linux') { execFileSync('xdg-open', ['tools/excluded-areas-builder.html'], { stdio: 'inherit' }); } else { throw new Error('Unsupported platform: development tooling is only supported on macOS and Linux'); }\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "pngjs": "~7.0.0"
    },
    "devDependencies": {
        "@babel/parser": "~7.29.15",
        "@jest/globals": "~30.5.2",
        "@playwright/test": "~1.65.1",
        "@types/node": "~26.6.6",
        "@types/pngjs": "~6.0.5",
        "@vitest/coverage-v8": "~5.1.1",
        "expect": "~30.5.2",
        "jest": "~30.5.2",
        "oxfmt": "~0.79.0",
        "oxlint": "~1.94.0",
        "pixelmatch": "~8.0.0",
        "typescript": "~7.0.2",
        "vitest": "~5.1.1"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.60.0 <2",
        "expect": "*",
        "jest": ">=29 <31",
        "vitest": ">=5.0.0 <6"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        },
        "expect": {
            "optional": true
        },
        "jest": {
            "optional": true
        },
        "vitest": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "overrides": {
        "deepmerge": "~4.1.2",
        "glob": "~14.0.6",
        "minimatch": "~11.0.9"
    },
    "os": [
        "darwin",
        "linux"
    ],
    "allowScripts": {
        "@parcel/watcher": false,
        "fsevents": false
    }
}
